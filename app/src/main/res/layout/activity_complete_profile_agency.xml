<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.housemaid.activities.agency.beforeHome.CompleteProfileAgency">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbar">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.housemaid.utils.MyTextView
                    android:id="@+id/tvCompleteProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:text="@string/please_complete_your_profile"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_below="@+id/tvCompleteProfile"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:progress="50"
                    android:progressDrawable="@drawable/progress_layout" />


                <com.housemaid.utils.MyTextView
                    android:id="@+id/tvBasicInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/progressBar"
                    android:layout_marginTop="15dp"
                    android:background="@color/colorDarkGrey"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:text="@string/basic_information"
                    android:textColor="@color/colorWhite"
                    android:textSize="17sp"
                    tools:ignore="RtlSymmetry" />


                <com.housemaid.utils.MyEditText
                    android:id="@+id/etCompanyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvBasicInfo"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:digits="@string/name_digits"
                    android:hint="@string/company_name"
                    android:inputType="text|textCapWords"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="15sp" />


                <com.housemaid.utils.MyEditText
                    android:id="@+id/etAutherizedPerson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etCompanyName"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:digits="@string/name_digits"
                    android:hint="@string/authorized_person"
                    android:inputType="text|textCapWords"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="15sp" />

                <RelativeLayout
                    android:id="@+id/rlCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etAutherizedPerson"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:padding="7dp">

                    <com.housemaid.utils.MyBoldTextView
                        android:id="@+id/tvCountry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/country"
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap" />

                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvCountryName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvCountry"
                        android:text=""
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="15sp" />

                    <android.support.v7.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/right_arrow" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rlCountry"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:padding="7dp">

                    <com.housemaid.utils.MyBoldTextView
                        android:id="@+id/tvState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/state"
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap" />

                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvStateName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvState"
                        android:text=""
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="15sp" />

                    <android.support.v7.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/right_arrow" />

                </RelativeLayout>

                <com.housemaid.utils.MyEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rlState"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:hint="@string/address"
                    android:digits="@string/name_digits"
                    android:inputType="text|textCapWords"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="15sp" />

                <com.housemaid.utils.MyEditText
                    android:id="@+id/etTaxAdministration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etAddress"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:digits="@string/name_digits"
                    android:hint="@string/tax_administration"
                    android:inputType="text|textCapWords"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="15sp" />

                <com.housemaid.utils.MyEditText
                    android:id="@+id/etTaxNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etTaxAdministration"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:digits="@string/name_digits"
                    android:hint="@string/tax_number"
                    android:inputType="number"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="15sp" />

                <com.housemaid.utils.MyEditText
                    android:id="@+id/etCompanyPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/etTaxNumber"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/custom_text_view_grey"
                    android:elevation="6dp"
                    android:digits="@string/name_digits"
                    android:hint="@string/company_phone"
                    android:inputType="number"
                    android:maxLength="12"
                    android:paddingEnd="10dp"
                    android:paddingStart="10dp"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="15sp" />

                <com.housemaid.utils.MyButton
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_below="@+id/etCompanyPhone"
                    android:layout_marginBottom="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_blue"
                    android:text="@string/submit"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="17sp"
                    android:textStyle="bold" />


            </RelativeLayout>
        </ScrollView>
    </RelativeLayout>
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"/>
    </FrameLayout>
</layout>
