<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <data>

        <variable
            name="userBean"
            type="com.housemaid.model.bean.UserBean" />

        <variable
            name="handler"
            type="com.housemaid.handler.HomeListingHandler" />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:cardBackgroundColor="@color/colorWhite"
        app:cardCornerRadius="10dp"
        app:cardElevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutSingleItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1.5"
                    app:cardCornerRadius="10dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivProfilePic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/user"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="2.5"
                    android:orientation="vertical">

                    <!--android:text="@{userBean.name}"-->
                    <com.housemaid.utils.MyBoldTextView
                        android:id="@+id/tvPersonName"
                        android:text="dsfdsf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="15sp" />

                        <com.housemaid.utils.MyTextView
                            android:id="@+id/tvPersonLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorGrey"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>


                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvUpdatedAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/colorGrey"
                        android:textSize="12sp" />



                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvPersonAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/colorGrey"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/layoutFavorite"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">


                    <CheckBox
                        android:id="@+id/checkboxFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@drawable/custom_favourite_check"
                        android:layout_marginStart="10dp"
                        android:clickable="false"
                        android:padding = "1dp"
                        android:layout_centerVertical="true"/>

                    <com.housemaid.utils.MyBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="1dp"
                        android:gravity="center_vertical"
                        android:text="@string/favorite"
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="12sp" />


                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/colorGrey" />

                <com.housemaid.utils.MyBoldTextView
                    android:id="@+id/tvMessage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableLeft="@drawable/message"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="@string/message"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="12sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="7dp"
                    android:background="@color/colorGrey" />

                <com.housemaid.utils.MyBoldTextView
                    android:id="@+id/tvShare"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableLeft="@drawable/share"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:text="@string/share"
                    android:textColor="@color/colorDarkGrey"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>

</layout>