<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewBooking"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/colorWhite"
        app:cardCornerRadius="10dp"
        app:cardElevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutSingleItem"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="5dp"
                android:orientation="horizontal"
                android:weightSum="5">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="2"
                    app:cardCornerRadius="10dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivProfilePic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:background="@drawable/user" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="3"
                    android:orientation="vertical"
                    >

                    <!--android:text="@{userBean.name}"-->
                    <com.housemaid.utils.MyBoldTextView
                        android:id="@+id/tvName"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stacy Keibler"
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="15sp" />


                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvPhoneNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:text="+91 999999999 "
                        android:textColor="@color/colorGrey"
                        android:textSize="12sp" />

                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvJobChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:text="Baby Care"
                        android:textColor="@color/colorGrey"
                        android:textSize="12sp" />


                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:text="@string/_12_nov_2018_2_50_pm"
                        android:textColor="@color/colorGrey"
                        android:textSize="12sp" />



                </LinearLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivListingMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_weight="0.3"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/more_grey"/>
            </LinearLayout>

            <com.housemaid.utils.MyButton
                android:id="@+id/btnRatingsAndReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="@color/colorPrimary"
                android:text="Ratings and Review"
                android:textAllCaps="false"
                android:padding="5dp"/>


        </LinearLayout>


    </androidx.cardview.widget.CardView>

</layout>