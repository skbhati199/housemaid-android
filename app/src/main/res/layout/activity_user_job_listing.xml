<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.housemaid.activities.UserJobListingActivity">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar_header" />
            <RelativeLayout
                android:id="@+id/rlSearch"
                android:layout_below="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="45dp">

                <android.support.v7.widget.AppCompatImageView
                    android:layout_width="30dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/search_grey"/>

                <AutoCompleteTextView
                    android:id="@+id/tvSearchMaid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="60dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/search"
                    android:layout_marginEnd="30dp"
                    android:textSize="17sp"
                    android:textColor="@color/colorDarkGrey"
                    android:padding="5dp"
                    android:inputType="text"
                    android:imeOptions="actionDone"/>
            </RelativeLayout>
            <com.housemaid.utils.MyTextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorGrey"
                android:layout_below="@+id/rlSearch"/>



                    <android.support.v7.widget.RecyclerView
                        android:layout_below="@+id/rlSearch"
                        android:id="@+id/rvUserJobListing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:listitem = "@layout/single_item_home_list_layout">

                    </android.support.v7.widget.RecyclerView>

        </RelativeLayout>
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_centerInParent="true"
            android:layout_gravity="center"/>

        <com.housemaid.utils.MyTextView
            android:id="@+id/tvNoData"
            android:drawableTop="@drawable/no_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_17sdp"
            android:text="No Listing Found."
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone"/>




    </FrameLayout>
</layout>
