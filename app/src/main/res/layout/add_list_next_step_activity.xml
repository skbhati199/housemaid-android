                    </RelativeLayout>



                    <LinearLayout
                       android:id="@+id/layoutAgeRange"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_marginStart="20dp"
                       android:layout_marginEnd="20dp">

                    <com.housemaid.utils.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:layout_marginTop="5dp"
                        android:text="@string/age_range"
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="17sp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.housemaid.utils.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:text="@string/min"
                            android:textColor="@color/colorGrey"
                            android:textSize="15sp"
                            tools:ignore="RtlSymmetry" />

                        <com.housemaid.utils.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:paddingEnd="18dp"
                            android:text="@string/max"
                            android:textColor="@color/colorGrey"
                            android:textSize="15sp"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        tools:ignore="RtlSymmetry">

                        <com.housemaid.utils.MyTextView
                            android:id="@+id/tvMinAge"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="start"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="1dp"
                            android:layout_below="@+id/tvMinAge"
                            android:background="@color/colorGrey" />

                        <com.housemaid.utils.MyTextView
                            android:id="@+id/tvMaxAge"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@null"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp"
                            tools:ignore="RelativeOverlap" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="1dp"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@+id/tvMaxAge"
                            android:layout_marginEnd="10dp"
                            android:background="@color/colorGrey" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp">

                        <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                            android:id="@+id/rangeSeekbar1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:bar_color="@color/colorLightGrey"
                            app:bar_highlight_color="@color/colorPrimary"
                            app:left_thumb_color="@color/colorLightGrey"
                            app:left_thumb_color_pressed="@color/colorLightGrey"
                            app:max_value="65"
                            app:min_value="16"
                            app:right_thumb_color="@color/colorLightGrey"
                            app:right_thumb_color_pressed="@color/colorLightGrey" />

                    </RelativeLayout>
                   </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorGrey" />

                    <com.housemaid.utils.MyButton
                        android:id="@+id/btnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
