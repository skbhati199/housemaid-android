                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp"
                            tools:ignore="RelativeOverlap" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlWorkStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/custom_text_view_grey"
                        android:elevation="6dp"
                        android:padding="1dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:rotation="90"
                            android:padding="7dp"
                            android:src="@drawable/right_arrow" />

                        <com.housemaid.utils.MyBoldTextView
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="5dp"
                            android:paddingStart="7dp"
                            android:text="@string/work_status"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                        <Spinner
                            android:id="@+id/spinnerWorkStatus"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_marginBottom="5dp"
                            android:layout_marginEnd="30dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/custom_textview"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="17sp" />
                    </RelativeLayout>


                    <RelativeLayout
                        android:id="@+id/rlDrivingLicence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/custom_text_view_grey"
                        android:elevation="6dp"
                        android:padding="1dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:padding="7dp"
                            android:rotation="90"
                            android:src="@drawable/right_arrow" />

                        <com.housemaid.utils.MyBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="7dp"
                            android:paddingTop="5dp"
                            android:text="@string/driving_licence"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                        <Spinner
                            android:id="@+id/spinnerDrivingLicence"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_marginBottom="5dp"
                            android:layout_marginEnd="30dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/custom_text_view_white"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlSmoke"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/custom_text_view_grey"
                        android:elevation="6dp"
                        android:padding="1dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:padding="7dp"
                            android:rotation="90"
                            android:src="@drawable/right_arrow" />

                        <com.housemaid.utils.MyBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="7dp"
                            android:paddingTop="5dp"
                            android:text="@string/smoke"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                        <Spinner
                            android:id="@+id/spinnerSmoke"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_marginBottom="5dp"
                            android:layout_marginEnd="30dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/custom_text_view_white"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp" />
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rlPetProblem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/custom_text_view_grey"
                        android:elevation="6dp"
                        android:padding="7dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/right_arrow" />

                        <com.housemaid.utils.MyBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_pet_problem"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap" />

                        <com.housemaid.utils.MyTextView
                            android:id="@+id/tvPetProblem"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:textColor="@color/colorDarkGrey"
                            android:textSize="15sp"
                            tools:ignore="RelativeOverlap" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlExperience"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/custom_text_view_grey"
                        android:elevation="6dp"
