<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/colorWhite"
        app:cardCornerRadius="10dp"
        app:cardElevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutSingleItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <android.support.v7.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1.5"
                    app:cardCornerRadius="10dp">

                    <android.support.v7.widget.AppCompatImageView
                        android:id="@+id/ivProfilePic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/user" />
                </android.support.v7.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="2.5"
                    android:orientation="vertical">

                    <!--android:text="@{userBean.name}"-->
                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvPersonName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I want a maid"
                        android:textColor="@color/colorDarkGrey"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <com.housemaid.utils.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/language"
                            android:textColor="@color/colorGrey"
                            android:textSize="12sp" />

                        <com.housemaid.utils.MyTextView
                            android:id="@+id/tvPersonLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/english"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@color/colorGrey"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvPhoneNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="9999999999"
                        android:textColor="@color/colorGrey"
                        android:textSize="12sp" />

                    <com.housemaid.utils.MyTextView
                        android:id="@+id/tvPersonAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Shop No. 786,Near Super-tech icon,Kala Pathar Marg, Indrapuram, India"
                        android:textColor="@color/colorGrey"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:weightSum="2">

                <com.housemaid.utils.MyTextView
                    android:id="@+id/btnDecline"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:textSize="17sp"
                    android:gravity="center_horizontal"
                    android:layout_weight="1"
                    android:text="@string/decline"
                    android:textColor="@color/colorDarkGrey" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/colorGrey"
                    android:layout_marginTop="5dp"/>

                <com.housemaid.utils.MyTextView
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:textSize="17sp"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:gravity="center_horizontal"
                    android:layout_weight="1"
                    android:text="@string/accept"
                    android:textColor="@color/colorPrimary" />


            </LinearLayout>
        </LinearLayout>
    </android.support.v7.widget.CardView>
</layout>